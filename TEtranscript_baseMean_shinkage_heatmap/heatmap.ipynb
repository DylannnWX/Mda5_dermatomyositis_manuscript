import os
import glob
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib as mpl

# =========================
# Settings
# =========================

INPUT_PATTERN = "*_gene_TE_analysis.txt"

# Row selection still uses RAW PBMC baseMean
BASEMEAN_CUTOFF = 1000

# =========================
# Shrinkage settings
# =========================
# Formula:
#   shrink_factor = (baseMean / (baseMean + SHRINK_BASEMEAN)) ** SHRINK_POWER
#   shrunken_log2FC = raw_log2FC * shrink_factor


APPLY_BASEMEAN_SHRINKAGE = True
SHRINK_BASEMEAN = 1000
SHRINK_POWER = 3.0

FILL_MISSING_LOG2FC = 0

CMAP = "bwr"
VMAX_ABS = None

FIG_WIDTH = 14
ROW_HEIGHT = 0.12
MIN_FIG_HEIGHT = 5
MAX_FIG_HEIGHT = 30

FONT_NAME = "Arial"

TITLE_FONT_SIZE = 14
AXIS_TITLE_FONT_SIZE = 12
XTICK_FONT_SIZE = 8
YTICK_FONT_SIZE = 6
SECTION_LABEL_FONT_SIZE = 12
COLORBAR_TITLE_FONT_SIZE = 14
COLORBAR_TICK_FONT_SIZE = 12

mpl.rcParams["font.family"] = FONT_NAME

REPEAT_TYPE_ORDER = [
    "LINE", "LTR_ERV", "SINE", "Satellite", "DNA",
    "LTR_other", "Simple_repeat", "Low_complexity", "Other"
]

PATIENT_ORDER = [
    "HC1",
    "HC2",
    "P12",
    "P15",
    "P18",
    "P6",
    "P17",
    "P7",
    "P8",
    "P11",
    "P13",
    "P19",
    "P16"
]

cols = ["repeat_id", "baseMean", "log2FoldChange", "lfcSE", "stat", "pvalue", "padj"]


# =========================
# Read data
# =========================

def read_te_analysis(file):
    df = pd.read_csv(file, sep="\t", header=0)

    if df.shape[1] == 6:
        df = df.reset_index()

    df.columns = cols[:df.shape[1]]

    for c in cols:
        if c not in df.columns:
            df[c] = np.nan

    df = df[cols].copy()

    # Keep repeat/TE rows only
    df = df[df["repeat_id"].astype(str).str.contains(":", regex=False)].copy()

    for c in ["baseMean", "log2FoldChange", "lfcSE", "padj"]:
        df[c] = pd.to_numeric(df[c], errors="coerce")

    df = df.dropna(subset=["repeat_id", "baseMean", "log2FoldChange"])

    return df


# =========================
# Shrinkage
# =========================

def shrink_log2fc_by_basemean(df):
    """
    Shrink log2FC toward zero based on baseMean.

    Formula:
        shrink_factor =
        (baseMean / (baseMean + SHRINK_BASEMEAN)) ** SHRINK_POWER

        shrunken_log2FC =
        raw_log2FC * shrink_factor

    This is an empirical baseMean-dependent shrinkage applied after TEtranscripts.
    """

    df = df.copy()

    df["baseMean_for_shrinkage"] = df["baseMean"].clip(lower=0)

    df["shrink_factor_baseMean"] = (
        df["baseMean_for_shrinkage"] /
        (df["baseMean_for_shrinkage"] + SHRINK_BASEMEAN)
    ) ** SHRINK_POWER

    df["log2FoldChange_raw"] = df["log2FoldChange"]

    df["log2FoldChange_shrunk"] = (
        df["log2FoldChange_raw"] * df["shrink_factor_baseMean"]
    )

    if APPLY_BASEMEAN_SHRINKAGE:
        df["log2FoldChange_for_plot"] = df["log2FoldChange_shrunk"]
    else:
        df["log2FoldChange_for_plot"] = df["log2FoldChange_raw"]

    return df


# =========================
# Helpers
# =========================

def get_repeat_type(repeat_id):
    repeat_id = str(repeat_id)

    if "LINE" in repeat_id:
        return "LINE"
    elif "ERV" in repeat_id:
        return "LTR_ERV"
    elif "SINE" in repeat_id:
        return "SINE"
    elif "Satellite" in repeat_id:
        return "Satellite"
    elif "DNA" in repeat_id:
        return "DNA"
    elif "LTR" in repeat_id:
        return "LTR_other"
    elif "Simple_repeat" in repeat_id:
        return "Simple_repeat"
    elif "Low_complexity" in repeat_id:
        return "Low_complexity"
    else:
        return "Other"


def short_repeat_label(repeat_id):
    return str(repeat_id).split(":", 1)[0]


def get_sample_type(project):
    p = project.lower()

    if "pbmc" in p:
        return "PBMC"
    elif "plasma" in p:
        return "plasma"
    else:
        return "unknown"


def order_columns(columns):
    ordered = []

    special_patterns = [
        "p12overp19",
        "p12over19",
        "p15overp16",
        "p15over16"
    ]

    def is_special(col):
        c = col.lower()
        return any(pattern in c for pattern in special_patterns)

    for patient in PATIENT_ORDER:
        matching = sorted([
            c for c in columns
            if (
                patient.lower() in c.lower()
                and not is_special(c)
                and c not in ordered
            )
        ])
        ordered.extend(matching)

    p12overp19 = sorted([
        c for c in columns
        if (
            "p12overp19" in c.lower()
            or "p12over19" in c.lower()
        )
    ])

    p15overp16 = sorted([
        c for c in columns
        if (
            "p15overp16" in c.lower()
            or "p15over16" in c.lower()
        )
    ])

    ordered.extend([c for c in p12overp19 if c not in ordered])
    ordered.extend([c for c in p15overp16 if c not in ordered])

    remaining = sorted([
        c for c in columns
        if c not in ordered
    ])

    ordered.extend(remaining)

    return ordered


def build_matrices(project_dfs):
    """
    Build matrices for each sample type.

    log2fc_mat:
        shrunken log2FC values used for plotting

    base_mean_mat:
        raw baseMean values used for row filtering

    shrink_factor_mat:
        shrinkage factor, useful for checking how much shrinkage was applied
    """

    log2fc_parts = []
    base_mean_parts = []
    shrink_factor_parts = []

    for project, df in project_dfs.items():
        df = df.drop_duplicates(subset=["repeat_id"], keep="first").copy()

        df = shrink_log2fc_by_basemean(df)

        log2fc_sub = (
            df[["repeat_id", "log2FoldChange_for_plot"]]
            .set_index("repeat_id")
            .rename(columns={"log2FoldChange_for_plot": project})
        )

        base_mean_sub = (
            df[["repeat_id", "baseMean"]]
            .set_index("repeat_id")
            .rename(columns={"baseMean": project})
        )

        shrink_factor_sub = (
            df[["repeat_id", "shrink_factor_baseMean"]]
            .set_index("repeat_id")
            .rename(columns={"shrink_factor_baseMean": project})
        )

        log2fc_parts.append(log2fc_sub)
        base_mean_parts.append(base_mean_sub)
        shrink_factor_parts.append(shrink_factor_sub)

    log2fc_mat = pd.concat(log2fc_parts, axis=1)
    base_mean_mat = pd.concat(base_mean_parts, axis=1)
    shrink_factor_mat = pd.concat(shrink_factor_parts, axis=1)

    return log2fc_mat, base_mean_mat, shrink_factor_mat


# =========================
# Row selection/order
# =========================

def get_pbmc_selected_repeats(pbmc_base_mean_mat):
    """
    Select repeats using RAW PBMC baseMean.

    A repeat is kept if it has baseMean > BASEMEAN_CUTOFF
    in at least one PBMC comparison.
    """

    return pbmc_base_mean_mat.index[
        (pbmc_base_mean_mat > BASEMEAN_CUTOFF).any(axis=1)
    ].tolist()


def make_ordered_repeat_list(pbmc_log2fc_mat, selected_repeats):
    """
    Order selected repeats by repeat type, then by max absolute shrunken PBMC log2FC.
    """

    available_repeats = [
        r for r in selected_repeats
        if r in pbmc_log2fc_mat.index
    ]

    log2fc_sub = pbmc_log2fc_mat.loc[available_repeats].copy()
    log2fc_sub = log2fc_sub.fillna(FILL_MISSING_LOG2FC)

    repeat_types = pd.Series(
        log2fc_sub.index.map(get_repeat_type),
        index=log2fc_sub.index,
        name="repeat_type"
    )

    ordered_rows = []

    for repeat_type in REPEAT_TYPE_ORDER:
        rows = log2fc_sub.index[repeat_types == repeat_type].tolist()

        if len(rows) == 0:
            continue

        sub = log2fc_sub.loc[rows].copy()
        row_score = sub.abs().max(axis=1)
        rows_ordered = row_score.sort_values(ascending=False).index.tolist()

        ordered_rows.extend(rows_ordered)

    remaining = [
        r for r in log2fc_sub.index
        if r not in ordered_rows
    ]

    if len(remaining) > 0:
        sub = log2fc_sub.loc[remaining].copy()
        row_score = sub.abs().max(axis=1)
        remaining_ordered = row_score.sort_values(ascending=False).index.tolist()
        ordered_rows.extend(remaining_ordered)

    # Force L1HS to first row if present
    l1hs_rows = [
        r for r in ordered_rows
        if short_repeat_label(r) == "L1HS"
    ]

    if len(l1hs_rows) > 0:
        l1hs = l1hs_rows[0]
        ordered_rows = [l1hs] + [r for r in ordered_rows if r != l1hs]

    return ordered_rows


def make_plot_matrix(log2fc_mat, ordered_repeats):
    available = [
        r for r in ordered_repeats
        if r in log2fc_mat.index
    ]

    mat = log2fc_mat.loc[available].copy()
    mat = mat.fillna(FILL_MISSING_LOG2FC)

    ordered_cols = order_columns(mat.columns)
    mat = mat[ordered_cols]

    # Reindex so plasma/PBMC have identical rows
    mat = mat.reindex(ordered_repeats)
    mat = mat.fillna(FILL_MISSING_LOG2FC)

    return mat


def get_section_labels(ordered_repeats):
    repeat_types = pd.Series(
        [get_repeat_type(r) for r in ordered_repeats],
        index=ordered_repeats
    )

    section_boundaries = []
    section_labels = []

    current_position = 0

    for repeat_type in REPEAT_TYPE_ORDER:
        rows = [r for r in ordered_repeats if repeat_types.loc[r] == repeat_type]

        if len(rows) == 0:
            continue

        section_start = current_position
        section_end = current_position + len(rows)

        section_boundaries.append(section_end)
        section_labels.append((repeat_type, section_start, section_end))

        current_position = section_end

    return section_boundaries, section_labels


# =========================
# Paired heatmap
# =========================

def plot_plasma_pbmc_side_by_side(plasma_mat, pbmc_mat, ordered_repeats, shared_vmax):
    section_boundaries, section_labels = get_section_labels(ordered_repeats)

    fig_height = min(
        max(MIN_FIG_HEIGHT, ROW_HEIGHT * len(ordered_repeats)),
        MAX_FIG_HEIGHT
    )

    fig, axes = plt.subplots(
        nrows=1,
        ncols=2,
        figsize=(FIG_WIDTH, fig_height),
        gridspec_kw={
            "width_ratios": [1, 1],
            "wspace": 0.08
        }
    )

    ax_plasma, ax_pbmc = axes

    im1 = ax_plasma.imshow(
        plasma_mat.values,
        aspect="auto",
        cmap=CMAP,
        vmin=-shared_vmax,
        vmax=shared_vmax
    )

    im2 = ax_pbmc.imshow(
        pbmc_mat.values,
        aspect="auto",
        cmap=CMAP,
        vmin=-shared_vmax,
        vmax=shared_vmax
    )

    # =========================
    # Plasma axis: show repeat labels
    # =========================

    ax_plasma.set_title(
        "plasma",
        fontsize=TITLE_FONT_SIZE,
        fontname=FONT_NAME,
        fontweight="bold"
    )

    ax_plasma.set_xticks(np.arange(plasma_mat.shape[1]))
    ax_plasma.set_xticklabels(
        plasma_mat.columns,
        rotation=45,
        ha="right",
        fontsize=XTICK_FONT_SIZE,
        fontname=FONT_NAME
    )

    ax_plasma.set_yticks(np.arange(plasma_mat.shape[0]))
    ax_plasma.set_yticklabels(
        [short_repeat_label(x) for x in plasma_mat.index],
        fontsize=YTICK_FONT_SIZE,
        fontname=FONT_NAME
    )

    ax_plasma.set_xlabel(
        "Comparison",
        fontsize=AXIS_TITLE_FONT_SIZE,
        fontname=FONT_NAME
    )

    ax_plasma.set_ylabel(
        "Repeat",
        fontsize=AXIS_TITLE_FONT_SIZE,
        fontname=FONT_NAME
    )

    ax_plasma.tick_params(axis="x", labelsize=XTICK_FONT_SIZE)
    ax_plasma.tick_params(axis="y", labelsize=YTICK_FONT_SIZE)

    # =========================
    # PBMC axis: no repeat labels
    # =========================

    ax_pbmc.set_title(
        "PBMC",
        fontsize=TITLE_FONT_SIZE,
        fontname=FONT_NAME,
        fontweight="bold"
    )

    ax_pbmc.set_xticks(np.arange(pbmc_mat.shape[1]))
    ax_pbmc.set_xticklabels(
        pbmc_mat.columns,
        rotation=45,
        ha="right",
        fontsize=XTICK_FONT_SIZE,
        fontname=FONT_NAME
    )

    ax_pbmc.set_yticks(np.arange(pbmc_mat.shape[0]))
    ax_pbmc.set_yticklabels([])

    ax_pbmc.set_xlabel(
        "Comparison",
        fontsize=AXIS_TITLE_FONT_SIZE,
        fontname=FONT_NAME
    )

    ax_pbmc.tick_params(axis="x", labelsize=XTICK_FONT_SIZE)
    ax_pbmc.tick_params(axis="y", length=0)

    # =========================
    # Section dividers
    # =========================

    for ax in [ax_plasma, ax_pbmc]:
        for boundary in section_boundaries[:-1]:
            ax.axhline(boundary - 0.5, color="black", linewidth=1.5)

    # Section labels on far left
    for repeat_type, start, end in section_labels:
        mid = (start + end - 1) / 2

        ax_plasma.text(
            -2.2,
            mid,
            repeat_type,
            ha="right",
            va="center",
            fontsize=SECTION_LABEL_FONT_SIZE,
            fontweight="bold",
            fontname=FONT_NAME,
            clip_on=False
        )

    # =========================
    # Shared colorbar outside PBMC
    # =========================

    cax = fig.add_axes([0.92, 0.20, 0.02, 0.60])

    cbar = fig.colorbar(im2, cax=cax)

    cbar_label = (
        f"shrunken log2FoldChange\n"
        f"factor = (baseMean / (baseMean + {SHRINK_BASEMEAN}))^{SHRINK_POWER}"
        if APPLY_BASEMEAN_SHRINKAGE
        else "log2FoldChange"
    )

    cbar.set_label(
        cbar_label,
        fontsize=COLORBAR_TITLE_FONT_SIZE,
        fontname=FONT_NAME
    )

    cbar.ax.tick_params(labelsize=COLORBAR_TICK_FONT_SIZE)

    for tick in cbar.ax.get_yticklabels():
        tick.set_fontname(FONT_NAME)
        tick.set_fontsize(COLORBAR_TICK_FONT_SIZE)

    fig.suptitle(
        (
            f"Repeat shrunken log2FC heatmap | "
            f"rows selected by raw PBMC baseMean > {BASEMEAN_CUTOFF}"
            if APPLY_BASEMEAN_SHRINKAGE
            else f"Repeat log2FC heatmap | rows selected by PBMC baseMean > {BASEMEAN_CUTOFF}"
        ),
        fontsize=TITLE_FONT_SIZE,
        fontname=FONT_NAME,
        fontweight="bold"
    )

    fig.subplots_adjust(
        left=0.22,
        right=0.90,
        bottom=0.20,
        top=0.92
    )

    plt.show()


# =========================
# Run
# =========================

all_files = sorted(glob.glob(INPUT_PATTERN))

all_project_dfs = {}

for file in all_files:
    project = os.path.basename(file).replace("_gene_TE_analysis.txt", "")
    all_project_dfs[project] = read_te_analysis(file)

print(f"Found {len(all_project_dfs)} projects")

pbmc_dfs = {
    project: df
    for project, df in all_project_dfs.items()
    if get_sample_type(project) == "PBMC"
}

plasma_dfs = {
    project: df
    for project, df in all_project_dfs.items()
    if get_sample_type(project) == "plasma"
}

print(f"PBMC projects: {len(pbmc_dfs)}")
print(f"Plasma projects: {len(plasma_dfs)}")

if len(pbmc_dfs) == 0:
    raise ValueError("No PBMC projects found. Cannot create PBMC-selected repeat list.")

if len(plasma_dfs) == 0:
    raise ValueError("No plasma projects found. Cannot create side-by-side plot.")

# Build matrices:
# log2FC matrices are shrunken values if APPLY_BASEMEAN_SHRINKAGE = True
# baseMean matrices are raw values
pbmc_log2fc, pbmc_base_mean, pbmc_shrink_factor = build_matrices(pbmc_dfs)
plasma_log2fc, plasma_base_mean, plasma_shrink_factor = build_matrices(plasma_dfs)

# Select rows based on RAW PBMC baseMean
selected_repeats = get_pbmc_selected_repeats(pbmc_base_mean)

print(f"Selected repeats from raw PBMC baseMean > {BASEMEAN_CUTOFF}: {len(selected_repeats)}")

if APPLY_BASEMEAN_SHRINKAGE:
    print(
        "Shrinkage formula: "
        f"log2FC * (baseMean / (baseMean + {SHRINK_BASEMEAN})) ** {SHRINK_POWER}"
    )
else:
    print("Shrinkage disabled. Plotting raw log2FC.")

ordered_repeats = make_ordered_repeat_list(
    pbmc_log2fc_mat=pbmc_log2fc,
    selected_repeats=selected_repeats
)

pbmc_mat = make_plot_matrix(
    log2fc_mat=pbmc_log2fc,
    ordered_repeats=ordered_repeats
)

plasma_mat = make_plot_matrix(
    log2fc_mat=plasma_log2fc,
    ordered_repeats=ordered_repeats
)

# Shared symmetric log2FC scale
if VMAX_ABS is not None:
    shared_vmax = VMAX_ABS
else:
    shared_vmax = max(
        np.nanmax(np.abs(pbmc_mat.values)),
        np.nanmax(np.abs(plasma_mat.values)),
        1
    )

print(f"Using shared color scale: {-shared_vmax:.3f} to {shared_vmax:.3f}")

plot_plasma_pbmc_side_by_side(
    plasma_mat=plasma_mat,
    pbmc_mat=pbmc_mat,
    ordered_repeats=ordered_repeats,
    shared_vmax=shared_vmax
)
