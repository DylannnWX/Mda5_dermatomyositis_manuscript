# ============================================================
# Locate AUC file
# ============================================================

def find_auc_file(rep, tissue):

    if tissue == "PBMC":

        path = (
            AUC_DIR /
            f"{rep}_PBMC.repeat_AUC.tsv"
        )

        if not path.exists():

            raise FileNotFoundError(
                path
            )

        return path


    if tissue == "plasma":

        explicit = (
            AUC_DIR /
            f"{rep}_plasma.repeat_AUC.tsv"
        )

        untagged = (
            AUC_DIR /
            f"{rep}.repeat_AUC.tsv"
        )


        if (
            explicit.exists() and
            untagged.exists()
        ):

            raise RuntimeError(
                f"Both plasma naming styles exist for {rep}:\n"
                f"{explicit}\n"
                f"{untagged}"
            )


        if explicit.exists():
            return explicit


        if untagged.exists():
            return untagged


        raise FileNotFoundError(
            f"No plasma AUC file found for {rep}"
        )


    raise ValueError(
        "tissue must be PBMC or plasma"
    )


# ============================================================
# Region-level log2FC
# ============================================================

def safe_log2fc(
    patient_auc,
    hc_auc
):

    patient_auc = np.asarray(
        patient_auc,
        dtype=float
    )

    hc_auc = np.asarray(
        hc_auc,
        dtype=float
    )


    out = np.zeros_like(
        patient_auc,
        dtype=float
    )


    both_positive = (
        (patient_auc > 0) &
        (hc_auc > 0)
    )


    out[both_positive] = np.log2(
        patient_auc[both_positive] /
        hc_auc[both_positive]
    )


    # Patient > 0, HC = 0
    out[
        (patient_auc > 0) &
        (hc_auc == 0)
    ] = np.inf


    # Patient = 0, HC > 0
    out[
        (patient_auc == 0) &
        (hc_auc > 0)
    ] = -np.inf


    # Both zero remains zero

    return out


# ============================================================
# Weighted quantile from histogram
# ============================================================

def weighted_quantile_from_hist(
    hist,
    centers,
    quantile
):

    hist = np.asarray(
        hist,
        dtype=float
    )

    centers = np.asarray(
        centers,
        dtype=float
    )


    total = hist.sum()


    if total <= 0:
        return np.nan


    cumulative = np.cumsum(
        hist
    )


    cutoff = (
        quantile *
        total
    )


    idx = np.searchsorted(
        cumulative,
        cutoff
    )


    idx = np.clip(
        idx,
        0,
        len(centers) - 1
    )


    return centers[idx]


# ============================================================
# Calculate one tissue
# ============================================================

def calculate_tissue(
    tissue,
    patients
):

    # --------------------------------------------------------
    # Required replicate files
    # --------------------------------------------------------

    reps = [
        "HC1a",
        "HC1b",
        "HC2a",
        "HC2b"
    ]


    for patient in patients:

        reps.extend([
            f"{patient}a",
            f"{patient}b"
        ])


    files = {

        rep:
            find_auc_file(
                rep,
                tissue
            )

        for rep in reps
    }


    print()
    print(
        "=" * 60
    )

    print(
        tissue
    )

    print(
        "=" * 60
    )


    for rep, path in files.items():

        print(
            f"{rep:8s} -> {path.name}"
        )


    # --------------------------------------------------------
    # HC1a is used as the annotation/reference stream
    # --------------------------------------------------------

    reference_rep = "HC1a"


    reference_iterator = pd.read_csv(
        files[reference_rep],
        sep="\t",
        usecols=[
            "TE_class",
            "RepeatMasker_label",
            "AUC"
        ],
        chunksize=CHUNK_SIZE
    )


    other_iterators = {}


    for rep, path in files.items():

        if rep == reference_rep:
            continue


        other_iterators[rep] = (
            pd.read_csv(
                path,
                sep="\t",
                usecols=["AUC"],
                chunksize=CHUNK_SIZE
            )
        )


    # --------------------------------------------------------
    # AUC-weighted log2FC histograms
    # --------------------------------------------------------

    histograms = {

        patient: {

            category:
                np.zeros(
                    len(FC_CENTERS),
                    dtype=np.float64
                )

            for category in CATEGORIES
        }

        for patient in patients
    }


    total_rows = 0


    # ========================================================
    # Stream through RepeatMasker regions
    # ========================================================

    for chunk_number, ref_chunk in enumerate(
        reference_iterator,
        start=1
    ):

        n_chunk = len(
            ref_chunk
        )


        total_rows += (
            n_chunk
        )


        # ----------------------------------------------------
        # Read AUC values
        # ----------------------------------------------------

        auc = {

            reference_rep:
                ref_chunk["AUC"]
                .to_numpy(float)
        }


        for rep, iterator in other_iterators.items():


            chunk = next(
                iterator,
                None
            )


            if chunk is None:

                raise RuntimeError(
                    f"{rep} ended before "
                    f"{reference_rep}"
                )


            if len(chunk) != n_chunk:

                raise RuntimeError(
                    f"Row mismatch for {rep}: "
                    f"{len(chunk)} vs {n_chunk}"
                )


            auc[rep] = (
                chunk["AUC"]
                .to_numpy(float)
            )


        # ----------------------------------------------------
        # Average control replicates
        # ----------------------------------------------------

        HC1 = (
            auc["HC1a"] +
            auc["HC1b"]
        ) / 2.0


        HC2 = (
            auc["HC2a"] +
            auc["HC2b"]
        ) / 2.0


        HC = (
            HC1 +
            HC2
        ) / 2.0


        # ----------------------------------------------------
        # RepeatMasker category annotation
        # ----------------------------------------------------

        te_class = (
            ref_chunk["TE_class"]
            .astype(str)
            .to_numpy()
        )


        repeat_labels = (
            ref_chunk[
                "RepeatMasker_label"
            ]
            .astype(str)
        )


        # ERV defined by RepeatMasker label containing ERV
        is_erv = (
            repeat_labels
            .str.contains(
                "ERV",
                case=False,
                na=False
            )
            .to_numpy()
        )


        category_masks = {

            "LINE":
                (
                    (te_class == "LINE") &
                    (~is_erv)
                ),

            "SINE":
                (
                    (te_class == "SINE") &
                    (~is_erv)
                ),

            "ERV":
                is_erv
        }


        # ====================================================
        # Each patient
        # ====================================================

        for patient in patients:


            # ------------------------------------------------
            # Average biological replicates
            # ------------------------------------------------

            patient_auc = (
                auc[f"{patient}a"] +
                auc[f"{patient}b"]
            ) / 2.0


            # ------------------------------------------------
            # Region-level log2FC
            # ------------------------------------------------

            region_log2fc = safe_log2fc(
                patient_auc,
                HC
            )


            # ------------------------------------------------
            # Convert +/-Inf to fixed distribution limits
            # ------------------------------------------------

            region_log2fc = np.nan_to_num(
                region_log2fc,
                nan=0.0,
                posinf=FC_CAP,
                neginf=-FC_CAP
            )


            region_log2fc = np.clip(
                region_log2fc,
                -FC_CAP,
                FC_CAP
            )


            # ------------------------------------------------
            # Each region is weighted by its mean AUC
            # between patient and HC
            # ------------------------------------------------

            auc_weight = (
                patient_auc +
                HC
            ) / 2.0


            # ------------------------------------------------
            # Build weighted distributions
            # ------------------------------------------------

            for category, mask in (
                category_masks.items()
            ):


                if not np.any(mask):
                    continue


                weighted_histogram, _ = (
                    np.histogram(
                        region_log2fc[mask],
                        bins=FC_EDGES,
                        weights=auc_weight[mask]
                    )
                )


                histograms[
                    patient
                ][category] += (
                    weighted_histogram
                )


        if (
            chunk_number %
            10 == 0
        ):

            print(
                f"{tissue}: "
                f"{total_rows:,} regions processed"
            )


    # ========================================================
    # Check for extra rows in any other TSV
    # ========================================================

    for rep, iterator in (
        other_iterators.items()
    ):

        extra_chunk = next(
            iterator,
            None
        )


        if extra_chunk is not None:

            raise RuntimeError(
                f"{rep} contains additional rows "
                f"after {reference_rep} ended."
            )


    # ========================================================
    # AUC-weighted paired-quantile score
    # ========================================================

    scores = pd.DataFrame(
        index=patients,
        columns=CATEGORIES,
        dtype=float
    )


    for patient in patients:

        for category in CATEGORIES:


            hist = (
                histograms[
                    patient
                ][category]
            )


            upper_quantile = (
                weighted_quantile_from_hist(
                    hist,
                    FC_CENTERS,
                    0.61
                )
            )


            lower_quantile = (
                weighted_quantile_from_hist(
                    hist,
                    FC_CENTERS,
                    0.39
                )
            )


            scores.loc[
                patient,
                category
            ] = (
                upper_quantile +
                lower_quantile
            )


    print()
    print(
        f"Finished {tissue}: "
        f"{total_rows:,} RepeatMasker regions"
    )


    return (
        scores,
        histograms
    )


