#!/bin/bash
set -euo pipefail

# ============================================================
# O2 modules
# ============================================================

module purge
module load gcc/14.2.0
module load samtools/1.21
module load bedtools/2.31.0
module load python/3.13.1

# ============================================================
# MAPQ >= 10 mapping -> coverage -> repeat AUC
# -> patient vs mean(HC1, HC2)
# -> differential regions |log2FC| > 1
# -> sum AUC by repeat class
#
# Usage:
#
# bash repeat_auc_pipeline.sh \
#     repeat_regions.bed \
#     HC1.bam \
#     HC2.bam \
#     P12 \
#     P12.bam \
#     output_P12
#
#
# repeat_regions.bed must contain at least:
#
# chr   start   end   repeat_id   repeat_class
#
# Example:
# chr1  10000   10500   repeat_0001   LINE
# chr1  20000   20400   repeat_0002   SINE
#
# ============================================================


# ============================================================
# Arguments
# ============================================================

if [ "$#" -lt 5 ]; then
    echo "Usage:"
    echo "bash $0 repeat_regions.bed HC1.bam HC2.bam PATIENT_NAME PATIENT.bam [OUTDIR]"
    exit 1
fi


REPEAT_BED=$1
HC1_BAM=$2
HC2_BAM=$3
PATIENT=$4
PATIENT_BAM=$5
OUTDIR=${6:-repeat_AUC_${PATIENT}}

THREADS=${THREADS:-8}


# ============================================================
# Check programs
# ============================================================

for prog in samtools bedtools python3; do
    if ! command -v "${prog}" >/dev/null 2>&1; then
        echo "ERROR: ${prog} not found"
        exit 1
    fi
done


# ============================================================
# Check files
# ============================================================

for f in "${REPEAT_BED}" "${HC1_BAM}" "${HC2_BAM}" "${PATIENT_BAM}"; do
    if [ ! -f "${f}" ]; then
        echo "ERROR: file not found: ${f}"
        exit 1
    fi
done


# ============================================================
# Output folders
# ============================================================

mkdir -p "${OUTDIR}"
mkdir -p "${OUTDIR}/unique_bam"
mkdir -p "${OUTDIR}/normalized_bedgraph"
mkdir -p "${OUTDIR}/repeat_AUC"
mkdir -p "${OUTDIR}/stats"


echo -e "sample\tmapq10_mapped" \
    > "${OUTDIR}/stats/mapq10_mapped_counts.tsv"


# ============================================================
# Function:
#
# BAM
#   ->
# MAPQ >= 10 BAM
#   ->
# MAPQ >= 10 alignment count
#   ->
# normalized bedGraph
#   ->
# AUC for every repeat interval
#
# Unique mapping is operationally defined here as:
#
# samtools view -q 10
#
# ============================================================

process_sample () {

    SAMPLE=$1
    BAM=$2

    echo
    echo "============================================================"
    echo "Processing ${SAMPLE}"
    echo "============================================================"


    # --------------------------------------------------------
    # Count alignments with MAPQ >= 10
    # --------------------------------------------------------

    N_MAPQ10=$(samtools view \
        -@ "${THREADS}" \
        -c \
        -q 10 \
        "${BAM}"
    )


    if [ "${N_MAPQ10}" -eq 0 ]; then
        echo "ERROR: ${SAMPLE} has zero alignments with MAPQ >= 10."
        exit 1
    fi


    echo "${SAMPLE}: ${N_MAPQ10} alignments with MAPQ >= 10"

    echo -e "${SAMPLE}\t${N_MAPQ10}" \
        >> "${OUTDIR}/stats/mapq10_mapped_counts.tsv"


    # --------------------------------------------------------
    # Make MAPQ >= 10 coordinate-sorted BAM
    # --------------------------------------------------------

    UNIQUE_BAM="${OUTDIR}/unique_bam/${SAMPLE}.MAPQ10.bam"

    samtools view \
        -@ "${THREADS}" \
        -bh \
        -q 10 \
        "${BAM}" \
    | samtools sort \
        -@ "${THREADS}" \
        -o "${UNIQUE_BAM}" \
        -


    samtools index \
        -@ "${THREADS}" \
        "${UNIQUE_BAM}"


    # --------------------------------------------------------
    # Generate normalized coverage bedGraph
    # --------------------------------------------------------

    BG="${OUTDIR}/normalized_bedgraph/${SAMPLE}.normalized.bedGraph"

    bedtools genomecov \
        -ibam "${UNIQUE_BAM}" \
        -bg \
    | awk \
        -v N="${N_MAPQ10}" \
        'BEGIN {
            OFS="\t"
        }
        {
            print $1,$2,$3,$4*1000000/N
        }' \
    > "${BG}"


    # --------------------------------------------------------
    # Calculate AUC for every repeat region
    # --------------------------------------------------------

    AUC_OUT="${OUTDIR}/repeat_AUC/${SAMPLE}.repeat_AUC.tsv"

    bedtools intersect \
        -a "${REPEAT_BED}" \
        -b "${BG}" \
        -wao \
    | awk '
        BEGIN {
            OFS="\t"

            print \
                "chr", \
                "start", \
                "end", \
                "repeat_id", \
                "repeat_class", \
                "AUC"
        }


        function output_previous() {

            if (have_region) {

                print \
                    prev_chr, \
                    prev_start, \
                    prev_end, \
                    prev_id, \
                    prev_class, \
                    auc
            }
        }


        {

            chr=$1
            start=$2
            end=$3
            id=$4
            class=$5

            key=chr FS start FS end FS id FS class


            if (!have_region) {

                previous_key=key

                prev_chr=chr
                prev_start=start
                prev_end=end
                prev_id=id
                prev_class=class

                auc=0

                have_region=1
            }


            if (key != previous_key) {

                output_previous()

                previous_key=key

                prev_chr=chr
                prev_start=start
                prev_end=end
                prev_id=id
                prev_class=class

                auc=0
            }


            if ($10 > 0 && $9 != ".") {

                auc += $9 * $10
            }
        }


        END {

            output_previous()
        }

    ' > "${AUC_OUT}"


    echo "Finished ${SAMPLE}"
    echo "  Coverage track: ${BG}"
    echo "  AUC table: ${AUC_OUT}"
}



# ============================================================
# Run HC1, HC2, and patient
# ============================================================

process_sample "HC1" "${HC1_BAM}"

process_sample "HC2" "${HC2_BAM}"

process_sample "${PATIENT}" "${PATIENT_BAM}"



# ============================================================
# Compare patient against average HC1/HC2
#
# HC_mean_AUC =
#
#     (HC1_AUC + HC2_AUC) / 2
#
#
# log2FC =
#
#     log2(patient_AUC / HC_mean_AUC)
#
#
# Differential:
#
#     log2FC > 1
#
# OR
#
#     log2FC < -1
#
#
# No pseudocount:
#
# patient > 0, HC = 0    -> +Inf
# patient = 0, HC > 0    -> -Inf
# both = 0               -> log2FC = 0
#
# ============================================================

echo
echo "============================================================"
echo "Comparing ${PATIENT} vs mean(HC1, HC2)"
echo "============================================================"


python3 - \
    "${PATIENT}" \
    "${OUTDIR}/repeat_AUC/HC1.repeat_AUC.tsv" \
    "${OUTDIR}/repeat_AUC/HC2.repeat_AUC.tsv" \
    "${OUTDIR}/repeat_AUC/${PATIENT}.repeat_AUC.tsv" \
    "${OUTDIR}" \
<<'PYTHON'

import csv
import math
import sys
from collections import defaultdict


patient = sys.argv[1]

hc1_file = sys.argv[2]
hc2_file = sys.argv[3]
patient_file = sys.argv[4]

outdir = sys.argv[5]


def read_auc(filename):

    data = {}

    with open(filename) as f:

        reader = csv.DictReader(f, delimiter="\t")

        for row in reader:

            key = (
                row["chr"],
                int(row["start"]),
                int(row["end"]),
                row["repeat_id"],
                row["repeat_class"]
            )

            data[key] = float(row["AUC"])

    return data


HC1 = read_auc(hc1_file)
HC2 = read_auc(hc2_file)
PAT = read_auc(patient_file)


if set(HC1) != set(HC2):

    missing_hc1 = len(set(HC2) - set(HC1))
    missing_hc2 = len(set(HC1) - set(HC2))

    raise RuntimeError(
        f"HC1 and HC2 repeat regions do not match. "
        f"Missing from HC1: {missing_hc1}; "
        f"missing from HC2: {missing_hc2}"
    )


if set(HC1) != set(PAT):

    missing_patient = len(set(HC1) - set(PAT))
    missing_hc = len(set(PAT) - set(HC1))

    raise RuntimeError(
        f"HC and {patient} repeat regions do not match. "
        f"Missing from patient: {missing_patient}; "
        f"missing from HC: {missing_hc}"
    )


all_regions_out = (
    f"{outdir}/{patient}.all_repeat_regions.tsv"
)

diff_regions_out = (
    f"{outdir}/{patient}.differential_repeat_regions.tsv"
)

class_out = (
    f"{outdir}/{patient}.differential_repeat_class_AUC.tsv"
)

direction_out = (
    f"{outdir}/{patient}.differential_repeat_class_AUC_by_direction.tsv"
)


class_sum = defaultdict(
    lambda: {
        "n": 0,
        "patient": 0.0,
        "hc1": 0.0,
        "hc2": 0.0,
        "hcmean": 0.0
    }
)


direction_sum = defaultdict(
    lambda: {
        "n": 0,
        "patient": 0.0,
        "hc1": 0.0,
        "hc2": 0.0,
        "hcmean": 0.0
    }
)


def calculate_log2fc(patient_auc, hc_auc):

    if patient_auc == 0 and hc_auc == 0:

        return 0.0

    elif hc_auc == 0:

        return math.inf

    elif patient_auc == 0:

        return -math.inf

    else:

        return math.log2(patient_auc / hc_auc)


header = [
    "chr",
    "start",
    "end",
    "repeat_id",
    "repeat_class",
    f"{patient}_AUC",
    "HC1_AUC",
    "HC2_AUC",
    "HC_mean_AUC",
    "log2FC",
    "direction"
]


n_total = 0
n_diff = 0
n_higher = 0
n_lower = 0


with \
    open(all_regions_out, "w", newline="") as all_f, \
    open(diff_regions_out, "w", newline="") as diff_f:


    all_writer = csv.writer(all_f, delimiter="\t")
    diff_writer = csv.writer(diff_f, delimiter="\t")

    all_writer.writerow(header)
    diff_writer.writerow(header)


    for key in HC1:

        n_total += 1

        chrom, start, end, repeat_id, repeat_class = key

        hc1 = HC1[key]
        hc2 = HC2[key]
        pat = PAT[key]

        hcmean = (hc1 + hc2) / 2.0


        log2fc = calculate_log2fc(
            pat,
            hcmean
        )


        if log2fc > 1:

            direction = "higher_in_patient"

        elif log2fc < -1:

            direction = "lower_in_patient"

        else:

            direction = "not_differential"


        row = [
            chrom,
            start,
            end,
            repeat_id,
            repeat_class,
            pat,
            hc1,
            hc2,
            hcmean,
            log2fc,
            direction
        ]


        all_writer.writerow(row)


        if not (log2fc < -1 or log2fc > 1):

            continue


        n_diff += 1

        if log2fc > 1:
            n_higher += 1
        else:
            n_lower += 1


        diff_writer.writerow(row)


        d = class_sum[repeat_class]

        d["n"] += 1
        d["patient"] += pat
        d["hc1"] += hc1
        d["hc2"] += hc2
        d["hcmean"] += hcmean


        d = direction_sum[(repeat_class, direction)]

        d["n"] += 1
        d["patient"] += pat
        d["hc1"] += hc1
        d["hc2"] += hc2
        d["hcmean"] += hcmean


with open(class_out, "w", newline="") as f:

    writer = csv.writer(f, delimiter="\t")

    writer.writerow([
        "repeat_class",
        "n_differential_regions",
        f"{patient}_sum_AUC",
        "HC1_sum_AUC",
        "HC2_sum_AUC",
        "HC_mean_sum_AUC"
    ])


    for repeat_class in sorted(class_sum):

        d = class_sum[repeat_class]

        writer.writerow([
            repeat_class,
            d["n"],
            d["patient"],
            d["hc1"],
            d["hc2"],
            d["hcmean"]
        ])


with open(direction_out, "w", newline="") as f:

    writer = csv.writer(f, delimiter="\t")

    writer.writerow([
        "repeat_class",
        "direction",
        "n_differential_regions",
        f"{patient}_sum_AUC",
        "HC1_sum_AUC",
        "HC2_sum_AUC",
        "HC_mean_sum_AUC"
    ])


    for repeat_class, direction in sorted(direction_sum):

        d = direction_sum[(repeat_class, direction)]

        writer.writerow([
            repeat_class,
            direction,
            d["n"],
            d["patient"],
            d["hc1"],
            d["hc2"],
            d["hcmean"]
        ])


print()
print("Repeat-region comparison finished.")
print()
print(f"Total repeat regions:        {n_total:,}")
print(f"Differential regions:        {n_diff:,}")
print(f"Higher in {patient}:          {n_higher:,}")
print(f"Lower in {patient}:           {n_lower:,}")
print()
print(f"All regions:")
print(f"  {all_regions_out}")
print()
print(f"Differential regions:")
print(f"  {diff_regions_out}")
print()
print(f"Repeat-class summary:")
print(f"  {class_out}")
print()
print(f"Direction-separated summary:")
print(f"  {direction_out}")

PYTHON


echo
echo "============================================================"
echo "DONE"
echo "============================================================"
echo
echo "Main result:"
echo
echo "  ${OUTDIR}/${PATIENT}.differential_repeat_class_AUC.tsv"
echo
