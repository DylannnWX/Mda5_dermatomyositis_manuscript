from pathlib import Path
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from matplotlib.colors import Normalize
from matplotlib.cm import ScalarMappable


# ============================================================
# Input / output
# ============================================================

AUC_DIR = Path(
    r"#your path"
)

OUTDIR = Path(
    "#your path"
)

OUTDIR.mkdir(
    parents=True,
    exist_ok=True
)


# ============================================================
# Analysis parameters
# ============================================================

CHUNK_SIZE = 100_000

FC_CAP = 8.0
BIN_WIDTH = 0.20
PEAK_HALF_WINDOW = 1.0  # Include histogram bins within +/-1 log2FC of peak

FC_EDGES = np.linspace(
    -FC_CAP,
    FC_CAP,
    int((2 * FC_CAP) / BIN_WIDTH) + 1
)

FC_CENTERS = (
    FC_EDGES[:-1] +
    FC_EDGES[1:]
) / 2


# ============================================================
# Samples
# ============================================================

PLASMA_PATIENTS = [
    "P12",
    "P15",
    "P18",
    "P6",
    "P17",
    "P7",
    "P8",
    "P11",
    "P13"
]

PBMC_PATIENTS = [
    "P12",
    "P15",
    "P6",
    "P7",
    "P8",
    "P11",
    "P13"
]

PLASMA_ORDER = [
    "HC1",
    "HC2"
] + PLASMA_PATIENTS

PBMC_ORDER = [
    "HC1",
    "HC2"
] + PBMC_PATIENTS

CATEGORIES = [
    "LINE",
    "SINE",
    "ERV"
]


# ============================================================
# Plot style
# ============================================================

plt.rcParams["font.family"] = "Arial"
plt.rcParams["figure.facecolor"] = "white"
plt.rcParams["axes.facecolor"] = "white"


# ============================================================
# Locate AUC file
# ============================================================

def find_auc_file(rep, tissue):

    if tissue == "PBMC":

        path = (
            AUC_DIR /
            f"{rep}_PBMC.repeat_AUC.tsv"
        )

        if not path.exists():
            raise FileNotFoundError(path)

        return path


    if tissue == "plasma":

        explicit = (
            AUC_DIR /
            f"{rep}_plasma.repeat_AUC.tsv"
        )

        untagged = (
            AUC_DIR /
            f"{rep}.repeat_AUC.tsv"
        )


        if explicit.exists() and untagged.exists():

            raise RuntimeError(
                f"Both plasma naming styles exist for {rep}:\n"
                f"{explicit}\n"
                f"{untagged}"
            )


        if explicit.exists():
            return explicit

        if untagged.exists():
            return untagged


        raise FileNotFoundError(
            f"No plasma AUC file found for {rep}"
        )


    raise ValueError(
        "tissue must be PBMC or plasma"
    )


# ============================================================
# Region-level log2FC
# ============================================================

def safe_log2fc(
    patient_auc,
    hc_auc
):

    patient_auc = np.asarray(
        patient_auc,
        dtype=float
    )

    hc_auc = np.asarray(
        hc_auc,
        dtype=float
    )


    out = np.zeros_like(
        patient_auc,
        dtype=float
    )


    both_positive = (
        (patient_auc > 0) &
        (hc_auc > 0)
    )


    out[both_positive] = np.log2(
        patient_auc[both_positive] /
        hc_auc[both_positive]
    )


    out[
        (patient_auc > 0) &
        (hc_auc == 0)
    ] = np.inf


    out[
        (patient_auc == 0) &
        (hc_auc > 0)
    ] = -np.inf


    return out


# ============================================================
# Peak-centered regional score
# ============================================================

def peak_centered_score(signal_hist, signal_x_hist):
    """Mean of actual regional log2FC values in bins near dominant AUC peak.

    signal_hist[b] = sum(mean_AUC_i) in bin b
    signal_x_hist[b] = sum(mean_AUC_i * log2FC_i) in bin b
    The selection is based on histogram BIN CENTERS, keeping computation
    one-pass and memory-efficient for large region files.
    """
    if not np.isfinite(signal_hist).all() or signal_hist.sum() <= 0:
        return np.nan

    peak_index = int(np.argmax(signal_hist))
    peak_center = FC_CENTERS[peak_index]
    selected = np.abs(FC_CENTERS - peak_center) <= PEAK_HALF_WINDOW + 1e-9
    denominator = signal_hist[selected].sum()
    if denominator <= 0:
        return np.nan

    return signal_x_hist[selected].sum() / denominator


# ============================================================
# Calculate one tissue
# ============================================================

def calculate_tissue(
    tissue,
    patients
):

    reps = [
        "HC1a",
        "HC1b",
        "HC2a",
        "HC2b"
    ]


    for patient in patients:

        reps.extend([
            f"{patient}a",
            f"{patient}b"
        ])


    files = {
        rep: find_auc_file(
            rep,
            tissue
        )
        for rep in reps
    }


    reference_rep = "HC1a"


    reference_iterator = pd.read_csv(
        files[reference_rep],
        sep="\t",
        usecols=[
            "TE_class",
            "RepeatMasker_label",
            "AUC"
        ],
        chunksize=CHUNK_SIZE
    )


    other_iterators = {}


    for rep, path in files.items():

        if rep == reference_rep:
            continue


        other_iterators[rep] = pd.read_csv(
            path,
            sep="\t",
            usecols=["AUC"],
            chunksize=CHUNK_SIZE
        )


    # Accumulate both the AUC mass and the AUC * log2FC sum per bin.
    # The second array allows the final score to use the actual log2FC
    # of each locus instead of approximating each locus by its bin center.
    histograms = {
        patient: {
            category: np.zeros(len(FC_CENTERS), dtype=np.float64)
            for category in CATEGORIES
        }
        for patient in patients
    }
    histogram_log2fc_sums = {
        patient: {
            category: np.zeros(len(FC_CENTERS), dtype=np.float64)
            for category in CATEGORIES
        }
        for patient in patients
    }


    for ref_chunk in reference_iterator:

        n_chunk = len(
            ref_chunk
        )


        auc = {

            reference_rep:
                ref_chunk["AUC"]
                .to_numpy(float)
        }


        for rep, iterator in other_iterators.items():

            chunk = next(
                iterator,
                None
            )


            if chunk is None:

                raise RuntimeError(
                    f"{rep} ended before "
                    f"{reference_rep}"
                )


            if len(chunk) != n_chunk:

                raise RuntimeError(
                    f"Row mismatch for {rep}: "
                    f"{len(chunk)} vs {n_chunk}"
                )


            auc[rep] = (
                chunk["AUC"]
                .to_numpy(float)
            )


        HC1 = (
            auc["HC1a"] +
            auc["HC1b"]
        ) / 2.0


        HC2 = (
            auc["HC2a"] +
            auc["HC2b"]
        ) / 2.0


        HC = (
            HC1 +
            HC2
        ) / 2.0


        te_class = (
            ref_chunk["TE_class"]
            .astype(str)
            .to_numpy()
        )


        repeat_labels = (
            ref_chunk[
                "RepeatMasker_label"
            ]
            .astype(str)
        )


        is_erv = (
            repeat_labels
            .str.contains(
                "ERV",
                case=False,
                na=False
            )
            .to_numpy()
        )


        category_masks = {

            "LINE":
                (
                    (te_class == "LINE") &
                    (~is_erv)
                ),

            "SINE":
                (
                    (te_class == "SINE") &
                    (~is_erv)
                ),

            "ERV":
                is_erv
        }


        for patient in patients:


            patient_auc = (
                auc[f"{patient}a"] +
                auc[f"{patient}b"]
            ) / 2.0


            region_log2fc = safe_log2fc(
                patient_auc,
                HC
            )


            region_log2fc = np.nan_to_num(
                region_log2fc,
                nan=0.0,
                posinf=FC_CAP,
                neginf=-FC_CAP
            )


            region_log2fc = np.clip(
                region_log2fc,
                -FC_CAP,
                FC_CAP
            )


            mean_auc = (
                patient_auc +
                HC
            ) / 2.0


            for category, mask in (
                category_masks.items()
            ):

                if not np.any(mask):
                    continue


                region_fc = region_log2fc[mask]
                region_signal = mean_auc[mask]
                signal_histogram, _ = np.histogram(
                    region_fc, bins=FC_EDGES, weights=region_signal
                )
                log2fc_sum_histogram, _ = np.histogram(
                    region_fc, bins=FC_EDGES,
                    weights=region_signal * region_fc
                )
                histograms[patient][category] += signal_histogram
                histogram_log2fc_sums[patient][category] += log2fc_sum_histogram


    for rep, iterator in (
        other_iterators.items()
    ):

        if next(
            iterator,
            None
        ) is not None:

            raise RuntimeError(
                f"{rep} contains additional rows "
                f"after {reference_rep} ended."
            )


    scores = pd.DataFrame(
        index=patients,
        columns=CATEGORIES,
        dtype=float
    )


    for patient in patients:

        for category in CATEGORIES:


            hist = (
                histograms[
                    patient
                ][category]
            )


            scores.loc[patient, category] = peak_centered_score(
                hist,
                histogram_log2fc_sums[patient][category]
            )


    return scores


# ============================================================
# Run plasma + PBMC
# ============================================================

plasma_scores = calculate_tissue(
    tissue="plasma",
    patients=PLASMA_PATIENTS
)

pbmc_scores = calculate_tissue(
    tissue="PBMC",
    patients=PBMC_PATIENTS
)


# ============================================================
# Save numerical TSV outputs
# ============================================================

plasma_scores.to_csv(
    OUTDIR /
    "plasma.repeat_analysis.tsv",
    sep="\t",
    index_label="sample"
)


pbmc_scores.to_csv(
    OUTDIR /
    "PBMC.repeat_analysis.tsv",
    sep="\t",
    index_label="sample"
)


combined_scores = pd.concat(
    [
        (
            plasma_scores
            .rename_axis("sample")
            .reset_index()
            .assign(
                tissue="plasma"
            )
        ),

        (
            pbmc_scores
            .rename_axis("sample")
            .reset_index()
            .assign(
                tissue="PBMC"
            )
        )
    ],
    ignore_index=True
)


combined_scores = combined_scores[
    [
        "sample",
        "tissue",
        "LINE",
        "SINE",
        "ERV"
    ]
]


combined_scores.to_csv(
    OUTDIR /
    "all_samples.repeat_analysis.tsv",
    sep="\t",
    index=False
)


# ============================================================
# Prepare heatmaps
# ============================================================

plasma_plot = (
    plasma_scores.copy()
)

pbmc_plot = (
    pbmc_scores.copy()
)


plasma_plot.loc["HC1"] = 0.0
plasma_plot.loc["HC2"] = 0.0

pbmc_plot.loc["HC1"] = 0.0
pbmc_plot.loc["HC2"] = 0.0


plasma_plot = (
    plasma_plot
    .reindex(
        PLASMA_ORDER
    )
    [CATEGORIES]
)


pbmc_plot = (
    pbmc_plot
    .reindex(
        PBMC_ORDER
    )
    [CATEGORIES]
)


# Negative values are clipped only for visualization
plasma_heat = (
    plasma_plot
    .clip(lower=0)
)

pbmc_heat = (
    pbmc_plot
    .clip(lower=0)
)


# ============================================================
# Plot
# ============================================================

fig, axes = plt.subplots(
    1,
    2,
    figsize=(13, 3.8),
    gridspec_kw={
        "width_ratios": [
            len(PLASMA_ORDER),
            len(PBMC_ORDER)
        ]
    }
)


cmap = plt.cm.Reds.copy()

cmap.set_bad(
    color="white"
)


axes[0].imshow(
    plasma_heat.values.T,
    aspect="auto",
    cmap=cmap,
    vmin=0,
    vmax=9
)


axes[0].set_title(
    "plasma",
    fontsize=18,
    fontweight="bold"
)


axes[0].set_xticks(
    range(
        len(PLASMA_ORDER)
    )
)


axes[0].set_xticklabels(
    PLASMA_ORDER,
    rotation=90,
    fontsize=13
)


axes[0].set_yticks(
    range(3)
)


axes[0].set_yticklabels(
    [
        "LINEs",
        "SINEs",
        "ERVs"
    ],
    fontsize=14
)


axes[1].imshow(
    pbmc_heat.values.T,
    aspect="auto",
    cmap=cmap,
    vmin=0,
    vmax=9
)


axes[1].set_title(
    "PBMC",
    fontsize=18,
    fontweight="bold"
)


axes[1].set_xticks(
    range(
        len(PBMC_ORDER)
    )
)


axes[1].set_xticklabels(
    PBMC_ORDER,
    rotation=90,
    fontsize=13
)


axes[1].set_yticks(
    range(3)
)


axes[1].set_yticklabels([])


sm = ScalarMappable(
    norm=Normalize(
        vmin=0,
        vmax=9
    ),
    cmap=cmap
)


sm.set_array([])


cbar = fig.colorbar(
    sm,
    ax=axes,
    fraction=0.025,
    pad=0.025
)


cbar.set_label(
    "Peak-centered regional log2FC",
    fontsize=11
)


plt.subplots_adjust(
    left=0.08,
    right=0.92,
    bottom=0.25,
    top=0.85,
    wspace=0.08
)


plt.savefig(
    OUTDIR /
    "plasma_PBMC.repeat_analysis.heatmap.png",
    dpi=150,
    bbox_inches="tight"
)


plt.show()
